# ============================================================
# Raqib (رقيب) — Arabic-first AI page moderation platform
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` (it is git-ignored).
# ============================================================

# --- environment --------------------------------------------------
APP_ENV=dev                    # dev | test | prod
APP_NAME=raqib
APP_URL=http://localhost:5173   # frontend origin

# --- auth / sessions ----------------------------------------------
# REQUIRED in production (min 32 random chars). Dev uses a default.
SECRET_KEY=
SESSION_TTL_HOURS=168
CSRF_ENABLED=true

# --- database ------------------------------------------------------
# Leave empty => SQLite at ./data/raqib.db
DATABASE_URL=
# DB_BACKEND=postgres            # postgresql+asyncpg://user:pass@host:5432/raqib
SQLITE_PATH=./data/raqib.db

# --- redis / jobs --------------------------------------------------
# Empty => in-process executor + in-memory rate limiter.
REDIS_URL=

# --- storage -------------------------------------------------------
STORAGE_DIR=./storage
MAX_ATTACHMENT_BYTES=20971520   # 20 MB

# --- owner store scraping (availability / price / shipping) --------
# e.g. https://my-store.com — salla / zid / shopify / woocommerce
STORE_URL=
STORE_SEARCH_TIMEOUT=15.0

# --- Meta Graph API -------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=

# --- AI / Ollama ----------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_FALLBACK_MODEL=qwen2.5:3b-instruct-q4_K_M
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# --- Knock notifications (optional) ---------------------------------
KNOCK_API_KEY=
KNOCK_SIGNING_KEY=
KNOCK_WORKFLOW_VERIFY=raqib-verify-email
KNOCK_WORKFLOW_IMPORT=raqib-import-done
KNOCK_WORKFLOW_ESCALATION=raqib-escalation
KNOCK_WORKFLOW_REVIEW=raqib-review-queue

# --- observability ---------------------------------------------------
LOG_LEVEL=INFO