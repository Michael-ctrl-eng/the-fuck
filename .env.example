# Database
DATABASE_URL=postgresql+asyncpg://mama:mama_secret@localhost:5432/mama_sales
DATABASE_URL_SYNC=postgresql://mama:mama_secret@localhost:5432/mama_sales

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# Facebook
FB_APP_ID=your-fb-app-id
FB_APP_SECRET=your-fb-app-secret
FB_VERIFY_TOKEN=your-webhook-verify-token
FB_GRAPH_API_URL=https://graph.facebook.com/v21.0

# Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_FROM_EMAIL=noreply@mamasales.com

# App
APP_NAME=Mama Sales Agent
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
