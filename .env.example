# Database
DATABASE_URL=postgresql+asyncpg://raqib:raqib_secret@localhost:5432/raqib_agent
DATABASE_URL_SYNC=postgresql://raqib:raqib_secret@localhost:5432/raqib_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM (free tier)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# Gemini Vision (free: 15 RPM, 1M tokens/day)
GEMINI_API_KEY=your-gemini-api-key

# Voice transcription (local, free via faster-whisper)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Facebook / Messenger
FB_APP_ID=your-fb-app-id
FB_APP_SECRET=your-fb-app-secret
FB_VERIFY_TOKEN=your-webhook-verify-token
FB_GRAPH_API_URL=https://graph.facebook.com/v21.0

# Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_FROM_EMAIL=noreply@raqib.app

# App
APP_NAME=Raqib Agent
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
