        {"id": "le_3004_m1", "created_time": "2026-08-04T16:55:00+00:00", "from": {"id": "u_5563", "name": "عمر نصار"}, "message": "أهلاً، شو مواعيد الدوام؟ وهل في فرع بالزرقاء؟"}
      ]}
    },
    {
      "id": "le_3005",
      "updated_time": "2026-08-05T08:30:00+00:00",
