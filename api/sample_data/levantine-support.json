      "messages": {"data": [
        {"id": "le_3001_m1", "created_time": "2026-08-03T10:50:00+00:00", "from": {"id": "u_5560", "name": "رامي الحلبي"}, "message": "مرحبا، بدي أسأل شو قيمة اشتراك النت الشهري؟ وهل في عروض للطلاب؟"},
        {"id": "le_3001_m2", "created_time": "2026-08-03T10:53:00+00:00", "from": {"id": "sample-page-levantine", "name": "تقنية الشرق"}, "message": "أهلاً رامي، باقة النت المنزلية ب 49 دولار شهرياً، وفي خصم 20% للطلاب مع إثبات هوية جامعية"},
        {"id": "le_3001_m3", "created_time": "2026-08-03T10:56:00+00:00", "from": {"id": "u_5560", "name": "رامي الحلبي"}, "message": "كتير منيح، بس لسا معي سؤال: هل في عقد التزام؟"}
      ]}
    },
    {
      "id": "le_3002",
      "updated_time": "2026-08-03T15:40:00+00:00",
      "participants": {"data": [{"id": "sample-page-levantine", "name": "تقنية الشرق"}, {"id": "u_5561", "name": "ليلى مراد"}]},
      "messages": {"data": [
        {"id": "le_3002_m1", "created_time": "2026-08-03T15:30:00+00:00", "from": {"id": "u_5561", "name": "ليلى مراد"}, "message": "الراوتر عندي عم يطفى كل كم ساعة، شو الحل؟ جربت أعيد تشغيله وما في فايدة"},
        {"id": "le_3002_m2", "created_time": "2026-08-03T15:33:00+00:00", "from": {"id": "sample-page-levantine", "name": "تقنية الشرق"}, "message": "نعتذر عن الإزعاج، هلق منبعثلك فني خلال 24 ساعة، أو فيك تجرب تحديث الفيرموير من التطبيق"},
        {"id": "le_3002_m3", "created_time": "2026-08-03T15:37:00+00:00", "from": {"id": "u_5561", "name": "ليلى مراد"}, "message": "شكراً كتير، بستنى الفني هلق"}
      ]}
    },
    {
      "id": "le_3003",
      "updated_time": "2026-08-04T09:20:00+00:00",
      "participants": {"data": [{"id": "sample-page-levantine", "name": "تقنية الشرق"}, {"id": "u_5562", "name": "حيدر الجبوري"}]},
      "messages": {"data": [
        {"id": "le_3003_m1", "created_time": "2026-08-04T09:10:00+00:00", "from": {"id": "u_5562", "name": "حيدر الجبوري"}, "message": "شنو السالفة؟ المودم انقطعت عنه الكهرباء وهسه ما يشتغل أبداً، أريد حل فوري"},
        {"id": "le_3003_m2", "created_time": "2026-08-04T09:13:00+00:00", "from": {"id": "sample-page-levantine", "name": "تقنية الشرق"}, "message": "أهلاً بك، جرب توصيل المودم بمقبس آخر مباشرة، وإن ما اشتغل راح نرسل لك مودم بديل خلال 48 ساعة"},
        {"id": "le_3003_m3", "created_time": "2026-08-04T09:16:00+00:00", "from": {"id": "u_5562", "name": "حيدر الجبوري"}, "message": "زين هواية، بس لعد إذا ما اشتغل شسوي؟"}
      ]}
    },
    {
      "id": "le_3004",
      "updated_time": "2026-08-04T17:00:00+00:00",
      "participants": {"data": [{"id": "sample-page-levantine", "name": "تقنية الشرق"}, {"id": "u_5563", "name": "عمر نصار"}]},
