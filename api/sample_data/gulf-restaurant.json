  "conversations": [
    {
      "id": "gu_2001",
      "updated_time": "2026-08-02T13:00:00+00:00",
      "participants": {"data": [{"id": "sample-page-gulf", "name": "مطعم ذواقة"}, {"id": "u_5556", "name": "فهد العتيبي"}]},
      "messages": {"data": [
        {"id": "gu_2001_m1", "created_time": "2026-08-02T12:50:00+00:00", "from": {"id": "u_5556", "name": "فهد العتيبي"}, "message": "السلام عليكم، وش أحلى شيء عندكم؟ أبغى أعزم العائلة اليوم"},
        {"id": "gu_2001_m2", "created_time": "2026-08-02T12:53:00+00:00", "from": {"id": "sample-page-gulf", "name": "مطعم ذواقة"}, "message": "وعليكم السلام يا أبا فهد، توصيتنا للمناسبات: طبق مندي الضأن ب 180 ريال يكفي 4 أشخاص، ويصير توصيل مجاني الحين"},
        {"id": "gu_2001_m3", "created_time": "2026-08-02T12:56:00+00:00", "from": {"id": "u_5556", "name": "فهد العتيبي"}, "message": "زين، كم تاخذون وقت للتوصيل؟ وتوه حجزت طاولة ب 7"}
      ]}
    },
    {
      "id": "gu_2002",
      "updated_time": "2026-08-02T18:10:00+00:00",
      "participants": {"data": [{"id": "sample-page-gulf", "name": "مطعم ذواقة"}, {"id": "u_5557", "name": "نورة القحطاني"}]},
      "messages": {"data": [
        {"id": "gu_2002_m1", "created_time": "2026-08-02T18:00:00+00:00", "from": {"id": "u_5557", "name": "نورة القحطاني"}, "message": "شلون أسجل في تطبيقكم؟ مدري ليش ما يشتغل معي، كل مرة يطلع خطأ"},
        {"id": "gu_2002_m2", "created_time": "2026-08-02T18:03:00+00:00", "from": {"id": "sample-page-gulf", "name": "مطعم ذواقة"}, "message": "نعتذر عن الإزعاج، جرّبي تحديث التطبيق من المتجر، وإن استمرت المشكلة أرسلي لنا لقطة شاشة على الدعم"},
        {"id": "gu_2002_m3", "created_time": "2026-08-02T18:06:00+00:00", "from": {"id": "u_5557", "name": "نورة القحطاني"}, "message": "ممتاز شكراً، اشتغل الحين الحمد لله"}
      ]}
    },
    {
      "id": "gu_2003",
      "updated_time": "2026-08-02T20:30:00+00:00",
      "participants": {"data": [{"id": "sample-page-gulf", "name": "مطعم ذواقة"}, {"id": "u_5558", "name": "خالد الدوسري"}]},
      "messages": {"data": [
        {"id": "gu_2003_m1", "created_time": "2026-08-02T20:20:00+00:00", "from": {"id": "u_5558", "name": "خالد الدوسري"}, "message": "واش هذا الحال؟ الطلب تأخر ساعة كاملة وهذا ما هو مقبول، أريد استرجاع المبلغ وإلا سأرفع بلاغاً رسمياً"},
        {"id": "gu_2003_m2", "created_time": "2026-08-02T20:25:00+00:00", "from": {"id": "sample-page-gulf", "name": "مطعم ذواقة"}, "message": "نعتذر بشدة عن التأخير، تم إرجاع قيمة الطلب كاملة لحسابك، وكوبون خصم 20% كاعتذار"}
      ]}
    },
    {
      "id": "gu_2004",
      "updated_time": "2026-08-03T09:15:00+00:00",
      "participants": {"data": [{"id": "sample-page-gulf", "name": "مطعم ذواقة"}, {"id": "u_5559", "name": "سعود الشمري"}]},
      "messages": {"data": [
        {"id": "gu_2004_m1", "created_time": "2026-08-03T09:10:00+00:00", "from": {"id": "u_5559", "name": "سعود الشمري"}, "message": "صباح الخير، كم سعر البوفيه المفتوح يوم الجمعة؟ وهل يشمل المشروبات؟"},
        {"id": "gu_2004_m2", "created_time": "2026-08-03T09:12:00+00:00", "from": {"id": "sample-page-gulf", "name": "مطعم ذواقة"}, "message": "صباح النور، بوفيه الجمعة ب 95 ريال للشخص، والمشروبات الغازية مشمولة والعصيرات الطازجة بسعر إضافي 15 ريال"}
      ]}
    }
  ]
}
